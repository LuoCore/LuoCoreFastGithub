<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<AssemblyName>LuoCoreFastGithub</AssemblyName>
		<OutputType>Exe</OutputType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

		<TargetFramework>net10.0</TargetFramework>

		<Version>2.0.0</Version>
	</PropertyGroup>




	<ItemGroup>
		<PackageReference Include="DnsCrypt.Blacklist" Version="0.1.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
		<PackageReference Include="Serilog.Sinks.Network" Version="3.0.0" />
		<ProjectReference Include="..\LuoCoreFastGithub.DomainResolve\LuoCoreFastGithub.DomainResolve.csproj" />
		<ProjectReference Include="..\LuoCoreFastGithub.HttpServer\LuoCoreFastGithub.HttpServer.csproj" />
		<ProjectReference Include="..\LuoCoreFastGithub.PacketIntercept\LuoCoreFastGithub.PacketIntercept.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings/appsettings.*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="appsettings/disabled/*.json" Link="appsettings/disabled/%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- WinDivert原生库与驱动：DNS/TCP包拦截层依赖，构建/发布时平铺拷贝到输出根目录 -->
		<None Include="@windivert\WinDivert.dll" Link="WinDivert.dll" CopyToOutputDirectory="PreserveNewest" Pack="false" />
		<None Include="@windivert\WinDivert64.sys" Link="WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" Pack="false" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Properties\" />
	</ItemGroup>

</Project>
